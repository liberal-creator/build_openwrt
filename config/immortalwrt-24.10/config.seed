### INITIALIZATION ###
CONFIG_TARGET_armsr=y                     # ARM 通用架构
CONFIG_TARGET_armsr_armv8=y               # ARMv8（64位）架构支持
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y  # 通用设备定义（无特定厂牌）
CONFIG_TARGET_ROOTFS_SQUASHFS=y      	  # SquashFS 只读压缩文件系统，常用作固件的根文件系统，节省空间且性能好
CONFIG_TARGET_ROOTFS_JFFS2=y         	  # JFFS2 作为写入层（overlay），支持可写分区，配合 SquashFS 实现读写分离
CONFIG_TARGET_ROOTFS_BTRFS=n      		  # Btrfs 作为根文件系统，支持快照、压缩和高级存储管理功能，适合需要高性能和灵活存储的场景
CONFIG_TARGET_ROOTFS_INITRAMFS=n          # initramfs 格式的 root 文件系统（通常用于内存启动或内核调试）
CONFIG_TARGET_ROOTFS_CPIOGZ=n             # gzip 压缩的 CPIO 格式文件系统（常用于特殊启动场景，如 initrd）
CONFIG_TARGET_ROOTFS_EXT4FS=n             # ext4 格式的 root 文件系统镜像（ext4 可读写，常用于虚拟机、SD 卡、U 盘部署）设置为 n 后将不会生成 openwrt-xxx-root.ext4 镜像

### WIFI（必需组件）###
CONFIG_PACKAGE_hostapd-common=y           # hostapd 共用组件（用于创建热点）
CONFIG_PACKAGE_iw=y                       # 无线管理工具（iwconfig/iw dev 等）
CONFIG_PACKAGE_kmod-brcmfmac=y            # Broadcom 无线驱动（仅限你硬件使用此驱动时启用）
CONFIG_PACKAGE_kmod-brcmutil=y            # Broadcom 无线驱动依赖库
CONFIG_PACKAGE_kmod-cfg80211=y            # 无线通用配置 API（所有无线驱动依赖）
CONFIG_PACKAGE_kmod-mac80211=y            # 通用 802.11 无线协议支持
CONFIG_PACKAGE_wpa-cli=y                  # WPA 控制命令行工具（用于连接 WiFi）
CONFIG_PACKAGE_wpad-basic=y               # WPA Daemon（用于 WiFi 客户端/热点认证）

### PPPOE（拨号必需组件）###
CONFIG_PACKAGE_ppp=y                      # PPP 协议支持
CONFIG_PACKAGE_ppp-mod-pppoe=y            # PPPoE 协议扩展（基于 PPP over Ethernet）
CONFIG_PACKAGE_luci-proto-ppp=y           # LuCI Web 支持 PPPoE 拨号协议
CONFIG_PACKAGE_kmod-pppoe=y               # 内核模块：PPPoE 驱动
CONFIG_PACKAGE_kmod-pppox=y               # 内核模块：PPP over X 协议支持
CONFIG_PACKAGE_kmod-ppp=y                 # 内核模块：PPP 协议核心支持

### LUCI ###
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y     # LuCI 基础界面简体中文语言包
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y # 防火墙界面中文包
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y     # 软件管理界面中文包
CONFIG_PACKAGE_luci-i18n-wireless-zh-cn=y # 无线设置界面中文包
CONFIG_PACKAGE_luci-theme-argon=y         # LuCI 界面主题（argon，推荐）

CONFIG_PACKAGE_luci-app-diskman=y         # 磁盘管理器，格式化磁盘或高级挂载
CONFIG_PACKAGE_luci-app-amlogic=y         # Amlogic 芯片相关
CONFIG_PACKAGE_luci-app-arpbind=y         # ARP 绑定
CONFIG_PACKAGE_luci-app-autoreboot=y      # 定时重启
CONFIG_PACKAGE_luci-app-homeproxy=y       # 科学上网相关（homeproxy 控制界面）
CONFIG_PACKAGE_luci-app-opkg=y            # 软件包管理界面
CONFIG_PACKAGE_luci-app-ramfree=y         # 释放内存工具
CONFIG_PACKAGE_luci-app-ttyd=y            # 网页终端（TTYD）
CONFIG_PACKAGE_luci-app-poweroffdevice=y  # 关机


### DOCKER（只启用核心组件）###
CONFIG_PACKAGE_luci-app-dockerman=y       # LuCI Docker 管理界面
CONFIG_PACKAGE_block-mount=y              # 挂载存储块设备（磁盘/U盘）
CONFIG_PACKAGE_docker-compose=y           # docker-compose 工具（可写 yml 运行多个容器）
CONFIG_DOCKER_CGROUP_OPTIONS=y            # 容器资源隔离（Cgroups）
CONFIG_DOCKER_OPTIONAL_FEATURES=y         # 额外功能支持（日志、健康检查等）
CONFIG_DOCKER_NET_MACVLAN=y               # macvlan 网络模式（容器独立 IP）
