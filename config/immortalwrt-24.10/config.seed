### INITIALIZATION ###
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

### WIFI ###
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_kmod-brcmutil=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_wpa-cli=y
CONFIG_PACKAGE_wpad-basic=y

### PPPOE ###
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-ppp=y

### LUCI ###
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wireless-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y

CONFIG_PACKAGE_luci-app-diskman
CONFIG_PACKAGE_luci-app-amlogic
CONFIG_PACKAGE_luci-app-arpbind
CONFIG_PACKAGE_luci-app-autoreboot
CONFIG_PACKAGE_luci-app-homeproxy
CONFIG_PACKAGE_luci-app-opkg
CONFIG_PACKAGE_luci-app-ramfree
CONFIG_PACKAGE_luci-app-ttyd
CONFIG_PACKAGE_luci-app-poweroff=y
CONFIG_PACKAGE_poweroff=y


### DOCKER ###
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_DOCKER_CGROUP_OPTIONS=y
CONFIG_DOCKER_OPTIONAL_FEATURES=y
CONFIG_DOCKER_NET_MACVLAN=y
